# 用途：按用户提供的 DeepSeek 调用格式配置规划器；密钥从 DEEPSEEK_API_KEY 单独读取。
ROBOPILOT_LLM_PROVIDER='deepseek'
ROBOPILOT_LLM_ENDPOINT='https://api.deepseek.com/chat/completions'
ROBOPILOT_LLM_MODEL='deepseek-flash'
ROBOPILOT_LLM_THINKING='enabled'
ROBOPILOT_LLM_REASONING_EFFORT='high'
ROBOPILOT_LLM_TIMEOUT_S='120'
# 在同一终端单独设置 DEEPSEEK_API_KEY，不需要安装 OpenAI SDK。
